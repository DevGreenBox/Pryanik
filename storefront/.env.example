# Витрина «Яркий пряник» — переменные окружения (см. docker-compose.yml платформы)

# Серверные (SSR) запросы к Storefront API Admik — внутри docker-сети.
ADMIK_API_URL=http://app:3000

# Публичный адрес API для клиентского бандла (браузер). Build-arg в Docker.
NEXT_PUBLIC_ADMIK_API_URL=https://admin.example.ru

# Публичный адрес самой витрины (абсолютные ссылки/SEO/sitemap).
NEXT_PUBLIC_SITE_URL=https://example.ru

# Ключ витрины, если Admik настроен на STOREFRONT_API_KEYS. ТОЛЬКО server-side.
STOREFRONT_API_KEY=
